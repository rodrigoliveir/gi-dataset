{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Weapon",
  "type": "object",

  "$defs": {
    "base_atk": {
      "type": "object",
      "properties": {
        "minimum": { "type": "integer" },
        "maximum": { "type": "integer" }
      },
      "required": ["minimum", "maximum"],
      "additionalProperties": false
    },
    "substatus": {
      "type": "object",
      "properties": {
        "minimum": { "type": "string", "format": "percent" },
        "maximum": { "type": "string", "format": "percent" }
      },
      "required": ["minimum", "maximum"],
      "additionalProperties": false
    },
    "upgrade": {
      "type": "object",
      "properties": {
        "base_atk": { "$ref": "#/$defs/base_atk" },
        "substatus": { "$ref": "#/$defs/substatus" }
      },
      "required": ["base_atk"],
      "additionalProperties": false
    },
    "upgrades": {
      "type": "array",
      "items": { "$ref": "#/$defs/upgrade" },
      "minItems": 7,
      "maxItems": 7
    },
    "ascension_material": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "integer" },
        "image": { "type": "string", "format": "uri" }
      },
      "required": ["name", "value", "image"],
      "additionalProperties": false
    },
    "level": {
      "type": "array",
      "items": { "$ref": "#/$defs/ascension_material" },
      "minItems": 4,
      "maxItems": 4
    },
    "ascension_materials": {
      "type": "array",
      "items": { "$ref": "#/$defs/level" },
      "minItems": 4,
      "maxItems": 6
    }
  },

  "properties": {
    "weapon_id": { "type": "string" },
    "weapon_type": {
      "type": "string",
      "enum": ["BOW", "CATALYST", "CLAYMORE", "POLEARM", "SWORD"]
    },
    "substatus": {
      "type": "string",
      "enum": ["ATK%", "DEF%", "HP%", "CD%", "CR%", "ELEMENTAL_MASTERY", "PHYSICAL_DAMAGE_BONUS"]
    },
    "name": { "type": "string" },
    "rarity": { "type": "integer", "enum": [1, 2, 3, 4, 5] },
    "description": { "type": "string" },
    "passive": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" }
      },
      "required": ["title", "content"],
      "additionalProperties": false
    },
    "upgrades": { "$ref": "#/$defs/upgrades" },
    "ascension_materials": { "$ref": "#/$defs/ascension_materials" },
    "image": { "type": "string", "format": "uri" }
  },
  "required": [
    "weapon_id",
    "weapon_type",
    "name",
    "rarity",
    "description",
    "upgrades",
    "ascension_materials",
    "image"
  ]
}
